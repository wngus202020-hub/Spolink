NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=your-vapid-private-key
WEB_PUSH_VAPID_SUBJECT=mailto:ops@example.com
SPOLINK_EDGE_SECRET=replace-with-at-least-16-random-characters

# NAVER Maps app client ID (used by Dynamic Map) and server-only geocoding secret.
NAVER_MAPS_CLIENT_ID=your-naver-maps-client-id
NAVER_MAPS_CLIENT_SECRET=your-naver-maps-client-secret

# Server-only base64url secret for signed auth callback/recovery markers.
# Generate locally with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SPOLINK_AUTH_FLOW_SECRET=base64url-encoded-32-byte-minimum-secret

# Local Supabase E2E fills these public values from `corepack pnpm supabase:status`.
# Do not place service-role keys, Toss secrets, Edge secrets, cookies, or JWTs in repo env files.
