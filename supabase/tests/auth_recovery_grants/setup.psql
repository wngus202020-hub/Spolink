create temp table todo3_recovery_actor (
  actor_key text primary key,
  id uuid not null,
  session_id text not null
) on commit drop;

insert into todo3_recovery_actor (actor_key, id, session_id)
values
  ('primary', '10000000-0000-4000-8000-000000000301', 'todo3-session-primary'),
  ('other_user', '10000000-0000-4000-8000-000000000302', 'todo3-session-other-user'),
  ('other_session', '10000000-0000-4000-8000-000000000301', 'todo3-session-other-session');

insert into auth.users (
  instance_id,
  id,
  aud,
  role,
  email,
  encrypted_password,
  email_confirmed_at,
  raw_app_meta_data,
  raw_user_meta_data,
  created_at,
  updated_at
)
select distinct on (id)
  '00000000-0000-0000-0000-000000000000',
  id,
  'authenticated',
  'authenticated',
  actor_key || '@todo3-recovery-grants.test',
  '',
  statement_timestamp(),
  '{"provider":"email","providers":["email"]}'::jsonb,
  '{}'::jsonb,
  statement_timestamp(),
  statement_timestamp()
from todo3_recovery_actor
on conflict (id) do nothing;

create function pg_temp.set_todo3_recovery_auth(checked_actor uuid, checked_session_id text)
returns void
language sql
as $$
  select set_config(
    'request.jwt.claims',
    jsonb_build_object(
      'sub', checked_actor,
      'role', 'authenticated',
      'session_id', checked_session_id
    )::text,
    true
  );
  select set_config('request.jwt.claim.sub', checked_actor::text, true);
  select set_config('request.jwt.claim.role', 'authenticated', true);
$$;

create function pg_temp.todo3_primary_actor()
returns uuid
language sql
stable
as $$
  select id from todo3_recovery_actor where actor_key = 'primary';
$$;

create function pg_temp.todo3_primary_session()
returns text
language sql
stable
as $$
  select session_id from todo3_recovery_actor where actor_key = 'primary';
$$;
