create function pg_temp.set_image_actor(checked_actor uuid, checked_role text default 'authenticated')
returns void language sql as $$
  select set_config(
    'request.jwt.claims',
    jsonb_build_object('sub', checked_actor, 'role', checked_role)::text,
    true
  );
  select set_config('request.jwt.claim.sub', coalesce(checked_actor::text, ''), true);
  select set_config('request.jwt.claim.role', checked_role, true);
$$;

create function pg_temp.hasnt_table_privilege(
  checked_role name,
  checked_relation text,
  checked_privilege text,
  checked_description text
)
returns text language sql as $$
  select ok(
    not pg_catalog.has_table_privilege(checked_role, checked_relation, checked_privilege),
    checked_description
  );
$$;
